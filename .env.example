# ============================================================
# Application
# ============================================================

APP_ENV=dev

# FastAPI 启动时自动执行 SQLAlchemy create_all()。
# 只创建缺失表，不会删除已有业务数据。
DATABASE_INITIALIZE_ON_STARTUP=true


# ============================================================
# Business Database
# ============================================================

# 用户、用户画像、TripDraft、TripVersion、ApprovalRecord。
DATABASE_URL=sqlite:///./data/db/travelops.db


# ============================================================
# LangGraph Runtime / Persistence / Human-in-the-loop
# ============================================================

# LangGraph Checkpoint 与业务 SQLite 分开保存。
LANGGRAPH_CHECKPOINT_DB=./data/db/langgraph_checkpoints.sqlite

# 限制 Checkpoint MessagePack 反序列化到安全类型。
LANGGRAPH_STRICT_MSGPACK=true

# SQLite 等待文件锁释放的最长时间，单位秒。
LANGGRAPH_SQLITE_TIMEOUT_SECONDS=30

# FastAPI 启动时构建一次完整 CompiledGraph。
# false 时第一次 API 请求懒初始化。
WORKFLOW_PRELOAD_ON_STARTUP=true

# 单次 invoke / resume 最大 Graph super-step 数。
WORKFLOW_RECURSION_LIMIT=100

# GET /runs/{thread_id}?include_trace=true 最多返回多少条 Trace 摘要。
API_TRACE_MAX_ITEMS=50

# Checkpoint History API 默认和最大返回数量。
API_HISTORY_DEFAULT_LIMIT=20
API_HISTORY_MAX_LIMIT=100

# Stage 5 轻量 Trace Harness 的进程内保留上限。
# 它不保存 Prompt/Evidence 原文，也不能替代后续阶段的持久化 Replay。
TRACE_MAX_RUNS=200
TRACE_MAX_SPANS_PER_RUN=500


# ============================================================
# Input Extraction / DeepSeek
# ============================================================

# llm：LLM-first，模型失败时规则 fallback；rule：完全离线的规则模式。
# hybrid 仅作为旧配置兼容别名，行为与 llm 相同。
INPUT_EXTRACT_MODE=llm
INPUT_EXTRACT_MAX_TOKENS=4096

# Policy-Constrained Tool Calling：天气、航班、酒店由 Policy 强制调用；
# LLM 只决定是否调用 search_city_activities。
TOOL_PLAN_MODE=llm
TOOL_PLAN_MAX_TOKENS=1024
TOOL_PLAN_MAX_RETRIES=1
TOOL_EXECUTE_MAX_RETRIES=1
ACTIVITY_TOOL_MAX_RESULTS=12

LLM_PROVIDER=deepseek
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash
LLM_THINKING_ENABLED=false
LLM_TEMPERATURE=0.1
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=2

DEEPSEEK_API_KEY=


# ============================================================
# Mock Providers / MCP
# ============================================================

# Mock 表示 MCP Server 最终从 data/mock 中读取模拟外部数据。
WEATHER_MODE=mock

# local：Node 直接调用本地 Tool，主要用于单元测试。
# mcp：Node 通过 MCP stdio Client -> Server -> Tool，正式演示使用。
TRAVEL_DATA_CLIENT_MODE=mcp

# MCP Server 的 Python 模块路径。
# Client 会使用当前 Python 解释器执行：
# python -m app.mcp.travel_data_server
MCP_TRAVEL_DATA_SERVER_MODULE=app.mcp.travel_data_server

# 一次 MCP 连接、initialize 和 Tool 调用的超时时间，单位秒。
MCP_TRAVEL_DATA_TIMEOUT_SECONDS=30


# ============================================================
# RAG Source Documents / Chroma
# ============================================================

RAG_DOCS_DIR=./data/rag_docs
RAG_CHROMA_DIR=./data/vector_store/chroma
RAG_CHROMA_COLLECTION=travelops_rag_v1
# 语料、Chunk 或 collection 改动后必须同步更新；用于 Trace / Eval 可复现性。
RAG_CORPUS_VERSION=v5-agentic-challenge

# 应用启动时加载 Markdown、同步 Chroma，并构建一次内存 BM25。
RAG_PRELOAD_ON_STARTUP=true

# Agentic RAG：LLM 生成 Information Needs/query，Rule Planner 仅作 fallback。
RAG_PLANNER_MODE=agentic
AGENTIC_RAG_SEMANTIC_JUDGE_ENABLED=true
AGENTIC_RAG_MAX_REPLANS=1
AGENTIC_RAG_MAX_INITIAL_TASKS=6
AGENTIC_RAG_MAX_REPAIR_TASKS=2
AGENTIC_RAG_PLANNER_MAX_TOKENS=3000
AGENTIC_RAG_JUDGE_MAX_TOKENS=2000


# ============================================================
# Embedding Model
# ============================================================

# 推荐本地路径：./models/paraphrase-multilingual-MiniLM-L12-v2
RAG_EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
RAG_EMBEDDING_DEVICE=cpu


# ============================================================
# RAG Chunking / Hybrid Search
# ============================================================

RAG_CHUNK_SIZE=600
RAG_CHUNK_OVERLAP=100

RAG_RRF_K=60
RAG_BM25_WEIGHT=1.0
RAG_VECTOR_WEIGHT=1.0
RAG_FETCH_MULTIPLIER=1


# ============================================================
# Cross-Encoder Rerank
# ============================================================

# 推荐本地路径：./models/bge-reranker-v2-m3
RAG_RERANK_MODEL=BAAI/bge-reranker-v2-m3
RAG_RERANK_DEVICE=cpu
RAG_RERANK_BATCH_SIZE=4
RAG_RERANK_MAX_LENGTH=512
RAG_RERANK_TOP_K_PER_TASK=5
RAG_RERANK_MIN_PER_HOTEL=1
RAG_RERANK_CACHE_SIZE=2048
RAG_RERANK_USE_FP16=false
RAG_RERANK_FALLBACK_ON_ERROR=true

# 前端默认使用 Hybrid RRF（Variant C），不加载 Cross-Encoder。
# true 仅用于高质量精排模式；Windows CPU 环境会自动应用稳定线程设置。
RAG_RERANK_ENABLED=false

# FastAPI 启动时预加载 Cross-Encoder。
RAG_RERANK_PRELOAD_ON_STARTUP=false


# ============================================================
# Proposal Generation
# ============================================================

PROPOSAL_MAX_TOKENS=8192
PROPOSAL_MAX_ATTEMPTS=2
PROPOSAL_MAX_EVIDENCE_ITEMS=24
PROPOSAL_MAX_EVIDENCE_CHARS=1200


# ============================================================
# Proposal Verifier / Revision Loop
# ============================================================

VERIFIER_FLOAT_TOLERANCE=0.01
VERIFIER_MAX_PROPOSAL_REPAIRS=1
VERIFIER_MAX_BUDGET_REPAIRS=1
VERIFIER_MAX_ISSUE_EXAMPLES=50


# ============================================================
# Revision Analysis
# ============================================================

REVISION_MAX_TOKENS=4096
REVISION_MAX_ATTEMPTS=2


# ============================================================
# Optional Web Search
# ============================================================

TAVILY_API_KEY=
